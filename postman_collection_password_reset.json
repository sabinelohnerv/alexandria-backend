{
    "info": {
        "_postman_id": "7f2d5eb1-9e3a-4f3d-8b2f-0e9d9b9b8a0b",
        "name": "Password Reset (OTP) – Solo Endpoints",
        "description": "Colección mínima para recuperar contraseña con OTP (request, resend, status GET/POST, confirm). Incluye variables y tests básicos. Asegúrate de que tu backend de email esté configurado (Gmail SMTP con App Password).",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://127.0.0.1:8000/api"
        },
        {
            "key": "email_demo",
            "value": "ana@sanjines.com"
        },
        {
            "key": "new_password_demo",
            "value": "NuevaPassw0rd!"
        }
    ],
    "item": [
        {
            "name": "Password Reset",
            "item": [
                {
                    "name": "Password - Request Reset (OTP)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/auth/password/request-reset/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "password",
                                "request-reset",
                                ""
                            ]
                        },
                        "auth": {
                            "type": "noauth"
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{email_demo}}\"\n}"
                        },
                        "description": "Genera y envía OTP al correo. Responde 200 aunque el email no exista (no enumeración)."
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Status 200/400/429\", function () {",
                                    "  pm.expect([200,400,429]).to.include(pm.response.code);",
                                    "});"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Password - Resend Reset (cooldown)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/auth/password/resend-reset/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "password",
                                "resend-reset",
                                ""
                            ]
                        },
                        "auth": {
                            "type": "noauth"
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{email_demo}}\"\n}"
                        },
                        "description": "Reenvía OTP respetando cooldown (60s por defecto) y throttling."
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Status 200/400/429\", function () {",
                                    "  pm.expect([200,400,429]).to.include(pm.response.code);",
                                    "});"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Password - Status (GET)",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/auth/password/status/?email={{email_demo}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "password",
                                "status",
                                ""
                            ],
                            "query": [
                                {
                                    "key": "email",
                                    "value": "{{email_demo}}"
                                }
                            ]
                        },
                        "auth": {
                            "type": "noauth"
                        },
                        "description": "Consulta estado del ticket de recuperación por query param."
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"HTTP 200 OK\", function () {",
                                    "  pm.expect(pm.response.code).to.eql(200);",
                                    "});"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Password - Status (POST)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/auth/password/status/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "password",
                                "status",
                                ""
                            ]
                        },
                        "auth": {
                            "type": "noauth"
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{email_demo}}\"\n}"
                        },
                        "description": "Consulta estado del ticket de recuperación por POST."
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"HTTP 200 OK\", function () {",
                                    "  pm.expect(pm.response.code).to.eql(200);",
                                    "});"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Password - Confirm Reset (cambiar contraseña)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/auth/password/confirm/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "password",
                                "confirm",
                                ""
                            ]
                        },
                        "auth": {
                            "type": "noauth"
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{email_demo}}\",\n  \"otp_code\": \"123456\",\n  \"new_password\": \"{{new_password_demo}}\"\n}"
                        },
                        "description": "Valida OTP y establece nueva contraseña. **Reemplaza** \"123456\" por el OTP real recibido por email."
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"HTTP 200 OK\", function () {",
                                    "  pm.expect(pm.response.code).to.eql(200);",
                                    "});"
                                ]
                            }
                        }
                    ]
                }
            ]
        }
    ]
}